LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_ADMIN_API_KEY=replace-with-langfuse-admin-api-key
LANGFUSE_SALT=replace-with-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-langfuse-encryption-key
LANGFUSE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
PA_EVAL_DEFAULT_OWNER_EMAIL=admin@163.com
PA_EVAL_DEFAULT_OWNER_EMAIL_DOMAIN=xxx.com
PA_EVAL_API_TIMEOUT=20
PA_EVAL_POSTGRES_POOL_MIN_SIZE=1
PA_EVAL_POSTGRES_POOL_MAX_SIZE=10
PA_EVAL_POSTGRES_POOL_TIMEOUT_SECONDS=10
PA_EVAL_POSTGRES_POOL_MAX_IDLE_SECONDS=300
PA_EVAL_POSTGRES_POOL_MAX_LIFETIME_SECONDS=1800
PA_EVAL_CLICKHOUSE_HTTP_MAX_CONNECTIONS=100
PA_EVAL_CLICKHOUSE_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
PA_EVAL_ANNOTATION_ADVANCED_FILTER_MAX_OFFSET=100000
PA_EVAL_CLICKHOUSE_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
PA_EVAL_CORS_ORIGINS=http://localhost:5173
PA_EVAL_FRONTEND_URL=http://localhost:5173
PA_EVAL_AUTH_COOKIE_NAME=thisisjustarandomstring
PA_EVAL_AUTH_SECRET=replace-with-a-long-random-secret
PA_EVAL_SUPER_ADMIN_EMAILS=admin@example.com
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
# 日志配置
PA_EVAL_LOG_LEVEL=INFO
PA_EVAL_LOG_DIR=.pa-eval/logs
PA_EVAL_LOG_FILE_NAME=pa-eval-backend.log
# 按天轮转，日志文件保留天数
PA_EVAL_LOG_RETENTION_DAYS=30
# 生产环境建议开启（JSON 结构化日志），本地开发可关闭
PA_EVAL_LOG_JSON_ENABLED=false
