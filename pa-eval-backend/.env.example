LANGFUSE_BASE_URL=http://localhost:3000
# 推荐使用 PA 专用命名；未配置时也兼容 Langfuse 原生命名 ADMIN_API_KEY。
LANGFUSE_ADMIN_API_KEY=replace-with-langfuse-admin-api-key
LANGFUSE_SALT=replace-with-langfuse-salt
ENCRYPTION_KEY=replace-with-langfuse-encryption-key
# ADMIN_API_KEY=replace-with-langfuse-native-admin-api-key
LANGFUSE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
PA_EVAL_DEFAULT_OWNER_EMAIL=admin@163.com
PA_EVAL_DEFAULT_OWNER_EMAIL_DOMAIN=xxx.com
PA_EVAL_API_TIMEOUT=20
PA_EVAL_OPENJUDGE_MAX_CONCURRENCY=32
PA_EVAL_REDIS_URL=redis://localhost:6379/0
PA_EVAL_RUNTIME_STREAM_PREFIX=pa-eval:jobs
PA_EVAL_RUNTIME_CONSUMER_GROUP=pa-eval-workers
PA_EVAL_RUNTIME_MODE=legacy
PA_EVAL_JOB_BATCH_SIZE=100
PA_EVAL_JOB_LEASE_SECONDS=120
PA_EVAL_JOB_HEARTBEAT_SECONDS=30
PA_EVAL_DISPATCH_VISIBILITY_SECONDS=30
PA_EVAL_CORS_ORIGINS=http://localhost:5173
PA_EVAL_FRONTEND_URL=http://localhost:5173
PA_EVAL_AUTH_COOKIE_NAME=thisisjustarandomstring
PA_EVAL_AUTH_SECRET=replace-with-a-long-random-secret
PA_EVAL_AUTH_PROVIDERS=github,enterprise_password,oidc
PA_EVAL_SUPER_ADMIN_EMAILS=admin@example.com
PA_EVAL_ENTERPRISE_AUTH_URL=https://iam.example.com/api/login
PA_EVAL_ENTERPRISE_AUTH_METHOD=POST
PA_EVAL_ENTERPRISE_AUTH_HEADERS_JSON={}
PA_EVAL_ENTERPRISE_AUTH_USERNAME_FIELD=username
PA_EVAL_ENTERPRISE_AUTH_PASSWORD_FIELD=password
PA_EVAL_ENTERPRISE_AUTH_EMAIL_JSON_PATH=data.email
PA_EVAL_ENTERPRISE_AUTH_NAME_JSON_PATH=data.name
PA_EVAL_ENTERPRISE_AUTH_USER_ID_JSON_PATH=data.userId
PA_EVAL_ENTERPRISE_AUTH_LOGIN_JSON_PATH=data.username
PA_EVAL_OIDC_CLIENT_ID=replace-with-oidc-client-id
PA_EVAL_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
PA_EVAL_OIDC_AUTHORIZE_URL=https://sso.example.com/oauth2/authorize
PA_EVAL_OIDC_TOKEN_URL=https://sso.example.com/oauth2/token
PA_EVAL_OIDC_USERINFO_URL=https://sso.example.com/oauth2/userinfo
PA_EVAL_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
PA_EVAL_OIDC_SCOPE=openid email profile
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
